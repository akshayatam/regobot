# Optional path and server overrides. No credentials are required by the MVP.
REGODIT_PROJECT_ROOT=
REGODIT_DATA_DIR=
REGODIT_ARTIFACT_DIR=
REGODIT_EVIDENCE_PATH=
REGODIT_PROFILE_DB=
REGODIT_CONVERSATION_DB=
REGODIT_HOST=127.0.0.1
REGODIT_PORT=8501

# OpenAI structured reasoning. Leave OPENAI_API_KEY unset to use the safe
# deterministic fallback; configure it for real model-backed investigations.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Block Convey PRISM observability. Tracing enables only when all three are set.
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
PRISMTRACE_HOST=
PRISMTRACE_AGENT_NAME=regodit-security-analyst
